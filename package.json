{
  "name": "conquest",
  "version": "2.0.0",
  "private": true,
  "description": "A family-friendly remake of Lords of Conquest: pass-and-play plus LAN multi-device play.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "serve": "node server/server.ts",
    "start": "npm run build && node server/server.ts",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "preact": "^10.29.8",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "typescript": "5.9",
    "vite": "^8.3.8"
  }
}