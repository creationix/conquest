{
  "name": "conquest",
  "version": "2.0.0",
  "private": true,
  "description": "A family strategy game of land, wealth and war: pass and play, or host a game and join it from other devices with a code.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host --port 8080",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "signal": "peerjs --port 9000 --path /"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "peerjs": "^1.5.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "peer": "^1.0.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.8"
  }
}
